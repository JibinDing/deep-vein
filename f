            --APP_ROLE_MTHS_AT_RES,
            B.GENDER_CODE,
            A.CREDIT_CARD_FINAL_LIMIT_AMOUNT AS FINAL_LIMIT
        FROM IHQ_Q A
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY_ROLE E
            ON E.APPLICATION_IDENTIFIER=A.APPLICATION_IDENTIFIER
            AND E.ACTIVE = '1'
            AND E.PRIMARY_APPLICANT_INDICATOR = 'Y'
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY B
            ON E.APPLICATION_PARTY_IDENTIFIER=B.APPLICATION_PARTY_INDENTIFIER
            AND B.ACTIVE = '1'
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY_ADDRESS C
            ON E.APPLICATION_PARTY_IDENTIFIER=C.APPLICATION_PARTY_IDENTIFIER
            AND C.ACTIVE = '1'
    ),

    --START CTE14
