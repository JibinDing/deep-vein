            AND B.ACTIVE = '1'
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY_ADDRESS C
            ON E.APPLICATION_PARTY_IDENTIFIER=C.APPLICATION_PARTY_IDENTIFIER
            AND C.ACTIVE = '1'
    ),

    --START CTE15
