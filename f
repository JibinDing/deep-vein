-- TEST DATA WINDOW: rolling last 7 days through CURRENT_DATE().
-- Replaced 8 production six-month date filters; the production procedure is unchanged.
-- Regenerate after every change to the source procedure.
WITH APP_DATA AS (
        SELECT APPLICATION_IDENTIFIER,
            QUOTE_STATUS_CODE,
            AUDIT_TIMESTAMP,
            SDS_COUNTER,
            RANK() OVER (
                PARTITION BY APPLICATION_IDENTIFIER
                ORDER BY QUOTE_STATUS_CODE DESC,
                    SDS_COUNTER
            ) AS PASS_ORDER,
            RANK() OVER (
                PARTITION BY APPLICATION_IDENTIFIER
                ORDER BY QUOTE_STATUS_CODE,
                    SDS_COUNTER DESC
            ) AS LAST_PASS,
            APPLICATION_RISK_SCORE,
            ANNUAL_PERCENTAGE_RATE AS APR,
            PRODUCT_CODE
        FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
        WHERE AUDIT_DATE >= DATEADD(DAY, -7, CURRENT_DATE())
            AND QUOTE_STATUS_CODE = 'F'
    ),

    --START CTE2
    --EXTRACT ALL THE QUOTE DATA AND CREATE A LAST PASS
    --TO USE LATER TO KEEP ONLY THE LATEST QUOTES BY APPLICATION_ID
    --THIS WILL INLUDE 1ST AND 2ND ELIGIBILITY QUOTES WHERE THE SAME
    --CUSTOMER HAS PROGRESSED FROM API TO ONUS AND BEEN GIVEN A
    --NEW CUSTOMER IDENTIFIER
    QUOTE_DATA AS (
        SELECT APPLICATION_IDENTIFIER,
            QUOTE_STATUS_CODE,
            AUDIT_TIMESTAMP,
            SDS_COUNTER,
            RANK() OVER (
                PARTITION BY APPLICATION_IDENTIFIER
                ORDER BY QUOTE_STATUS_CODE DESC,
                    SDS_COUNTER
            ) AS PASS_ORDER,
            RANK() OVER (
                PARTITION BY APPLICATION_IDENTIFIER
                ORDER BY QUOTE_STATUS_CODE,
                    SDS_COUNTER DESC
            ) AS LAST_PASS,
            APPLICATION_RISK_SCORE,
            ANNUAL_PERCENTAGE_RATE AS APR,
            PRODUCT_CODE
        FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
        WHERE AUDIT_DATE >= DATEADD(DAY, -7, CURRENT_DATE())
            AND QUOTE_STATUS_CODE = 'Q'
    ),

    --START CTE3
    --UNION THE TWO DATASETS TOTHER TO GET A FINAL
    --COMBINED WITH LAST QUOTES AND LAST APPLICATIONS
    --ALL IN ONE DATASET
    --THIS WILL INLUDE 1ST AND 2ND ELIGIBILITY QUOTES WHERE THE SAME
    --CUSTOMER HAS PROGRESSED FROM API TO ONUS AND BEEN GIVEN A
    --NEW CUSTOMER IDENTIFIER, WHICH IS NOT PICKED UP UNTIL WE
    --INTERROGATE THE CREDIT_CARD_APPLICATION_TABLE
    IHQ_SDS_SORT AS (
        SELECT APPLICATION_IDENTIFIER AS SDS_APP,
            AUDIT_TIMESTAMP,
            SDS_COUNTER,
            APPLICATION_RISK_SCORE AS GEN16_OM_PRIME_SCORE,
            APR,
            PRODUCT_CODE,
            QUOTE_STATUS_CODE
        FROM APP_DATA
        WHERE LAST_PASS = 1
        UNION
        SELECT APPLICATION_IDENTIFIER AS SDS_APP,
            AUDIT_TIMESTAMP,
            SDS_COUNTER,
            APPLICATION_RISK_SCORE AS GEN16_OM_PRIME_SCORE,
            APR,
            PRODUCT_CODE,
            QUOTE_STATUS_CODE
        FROM QUOTE_DATA
        WHERE LAST_PASS = 1
    ),

    --START CTE4
    --JOIN ON ALL DATA SO GET A 1:1 MATCHING FOR APPLICATIONS AND QUOTES
    --AND ADD IT DATA REQUIRED FROM APPLICATION_OUTCOME
    STG_1 AS (
        SELECT SDS_SORT.*,
            --APP.AUDIT_DATE,
            APP.REQUESTED_PRODUCT_DMI_CODE,
            APP.REQUESTED_PRODUCT_CLASS_CODE,
            APP.SOURCE_PRODUCT_CODE,
            APP.NET_MONTHLY_INCOME_AMOUNT,
            APP.APR_PERCENTAGE_APPLIED_AMOUNT,
            APP.MAIL_NUMBER,
            APP.APPLICATION_CHANNEL_CODE,
            OUTCOME.NODE_FRAMEWORK_RISK_SEGMENT_CODE,
            OUTCOME.RISK_EVALUATION_SCORECARD_NAME,
            APP.PRE_APPROVED_INDICATOR,
            APP.VOID_PRE_APPROVED_INDICATOR,
            APP.APPLICATION_REASON_CODE,
            APP.DECISION_ENGINE_APPLICATION_STATUS,
            APP.CREDIT_CARD_FINAL_LIMIT_AMOUNT,
            APP.INCOME_VALIDATION_REQUIRED_INDICATOR,
            APP.OFFERED_PRODUCT_DMI_CODE,
            APP.PRODUCT_ACCEPTANCE_TYPE_CODE,
            APP.APPLICATION_REDECISION_INDICATOR,
            APP.CREDIT_RISK_OVERRIDE_INDICATOR,
            APP.PRODUCT_RISK_OVERRIDE_INDICATOR,
            APP.BALANCE_TRANSFER_INDICATOR,
            APP.CARD_PRIMARY_USE_CODE,
            CASE WHEN APP.SCORECARD_SDS_CODE IN ('12','13') THEN 'Gen 12'
                WHEN APP.SCORECARD_SDS_CODE IN ('15','16') THEN 'Gen 16'
            END AS GEN_RULES,
            APP.AVERAGE_RISK_SCORE
        FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME AS APP
        JOIN IHQ_SDS_SORT AS SDS_SORT
            ON SDS_SORT.SDS_APP = APP.APPLICATION_IDENTIFIER
            AND SDS_SORT.AUDIT_TIMESTAMP = APP.AUDIT_TIMESTAMP
            AND SDS_SORT.SDS_COUNTER = APP.SDS_COUNTER
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_OUTCOME AS OUTCOME
            ON SDS_SORT.SDS_APP = OUTCOME.APPLICATION_IDENTIFIER
            AND SDS_SORT.AUDIT_TIMESTAMP = OUTCOME.AUDIT_TIMESTAMP
            AND SDS_SORT.SDS_COUNTER = OUTCOME.SDS_COUNTER
        WHERE APP.AUDIT_DATE >= DATEADD(DAY, -7, CURRENT_DATE())
    ),

