    --CARRY OUT ADDITIONAL CALULATION FOR THE GUARANTEED BT INDICATOR
    --NEEDED TO BE DONE IN SEPARATE STEP AS COULD NOT BE DONE IN SAME
    --SECTION WHERE THE BT OFFERED AND REQUESTED WERE COALESCED
    FQ_FINAL AS (
        SELECT A.*,
            CASE
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_1 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_1_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_2 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_2_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_3 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_3_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_4 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_4_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_5 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_5_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_6 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_6_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_7 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_7_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_8 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_8_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_9 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_9_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_10 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_10_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_11 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_11_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_12 = 'Y' AND APP_FLAG = 'Quote To App'
                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_12_code), 1, 2) THEN 'Y'
                WHEN A.GUARANTEED_BALANCE_TRANSFER_INDICATOR_PRODUCT_13 = 'Y' AND APP_FLAG = 'Quote To App'
