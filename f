    --START CTE13
    --START THE PROCESS OF CREATING THE FILEDS USED
    --COMBINING QUOTES AND DIRECT
    ALL_APPS AS (
        SELECT
            COALESCE(A.APPLICATION_IDENTIFIER,B.APPLICATION_IDENTIFIER) AS APPLICATION_IDENTIFIER
            ,CAST(COALESCE(A.CASE_CREATION_DATE,B.CASE_CREATION_DATE) AS VARCHAR(10)) AS CASE_CREATION_DATE
            ,CAST(COALESCE(A.APPLICATION_APPROVAL_DATE,B.APPLICATION_APPROVAL_DATE) AS VARCHAR(10)) AS DECISION_DATE
            ,CAST(CASE WHEN A.QUOTE_STATUS_CODE='F' THEN 'Quote To App'
                ELSE 'Quote Only' END AS VARCHAR(15)) AS APP_FLAG
            ,CAST(CASE WHEN TRIM(B.DECISION_ENGINE_APPLICATION_STATUS)='Accept' THEN 'Accept'
                WHEN TRIM(B.DECISION_ENGINE_APPLICATION_STATUS) IN ('Decline','Cancel','Cancelled') THEN 'Not Eligible'
                ELSE 'Refer' END AS VARCHAR(15)) AS QUOTE_DECISION
            ,COALESCE(A.FULL_APPLICATION_STATUS_CODE, B.FULL_APPLICATION_STATUS_CODE) AS FULL_APPLICATION_STATUS_CODE
            ,COALESCE(A.QUOTE_APPLICATION_STATUS_CODE, B.QUOTE_APPLICATION_STATUS_CODE) AS QUOTE_APPLICATION_STATUS_CODE
            ,A.APPLICATION_REDECISION_INDICATOR
            ,COALESCE(A.CREDIT_CARD_FINAL_LIMIT_AMOUNT, B.CREDIT_CARD_FINAL_LIMIT_AMOUNT) AS CREDIT_CARD_FINAL_LIMIT_AMOUNT
            ,A.OFFERED_PRODUCT_DMI_CODE AS OFFERED_PRODUCT_DMI_CODE
            ,CAST(CASE WHEN TRIM(A.AGGREGATOR_INDICATOR)='' OR A.AGGREGATOR_INDICATOR IS NULL THEN B.AGGREGATOR_INDICATOR
                ELSE A.AGGREGATOR_INDICATOR END AS VARCHAR(1)) AS AGGREGATOR_INDICATOR
            ,CAST(COALESCE(A.INTERNET_MEDIA_CODE,B.INTERNET_MEDIA_CODE) AS VARCHAR(20)) AS INTERNET_MEDIA_CODE
            ,CAST(COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) AS VARCHAR(1)) AS REQUESTED_PRODUCT_CLASS_CODE
            ,CAST(COALESCE(A.ORIGIN,B.ORIGIN) AS VARCHAR(20)) AS ORIGIN
            ,CAST(COALESCE(A.CHANNEL_CODE,B.CHANNEL_CODE) AS VARCHAR(2)) AS CHANNEL_CODE
            ,CAST(COALESCE(A.REQUESTED_PRODUCT_DMI_CODE,B.REQUESTED_PRODUCT_DMI_CODE) AS VARCHAR(9)) AS REQUESTED_PRODUCT_DMI_CODE
            ,CAST(COALESCE(A.INCOME_VALIDATION_REQUIRED_INDICATOR,B.INCOME_VALIDATION_REQUIRED_INDICATOR) AS VARCHAR(7)) AS INCOME_VALIDATION_REQUIRED_INDICATOR
            ,CAST(COALESCE(A.PRE_APPROVED_INDICATOR,B.PRE_APPROVED_INDICATOR) AS VARCHAR(1)) AS PRE_APPROVED_INDICATOR
            ,CAST(COALESCE(A.VOID_PRE_APPROVED_INDICATOR,B.VOID_PRE_APPROVED_INDICATOR) AS VARCHAR(1)) AS VOID_PRE_APPROVED_INDICATOR
            ,CAST(COALESCE(A.APPLICATION_REASON_CODE,B.APPLICATION_REASON_CODE) AS VARCHAR(80)) AS APPLICATION_REASON_CODE
            ,CAST(COALESCE(A.CREDIT_RISK_OVERRIDE_INDICATOR,B.CREDIT_RISK_OVERRIDE_INDICATOR) AS VARCHAR(1)) AS CREDIT_RISK_OVERRIDE_INDICATOR
            ,CAST(COALESCE(A.PRODUCT_RISK_OVERRIDE_INDICATOR,B.PRODUCT_RISK_OVERRIDE_INDICATOR) AS VARCHAR(1)) AS PRODUCT_RISK_OVERRIDE_INDICATOR
            ,B.APPLICATION_REASON_CODE AS REASON_CODES_LONG_QUOTES
            ,CAST(CASE
                WHEN COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) IN ('U','V') THEN 'Amazon'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) IN ('26','86') THEN 'Forward'
                WHEN COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) = 'P' THEN 'Combo'
                WHEN COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) = 'X' THEN 'Rewards'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) = '33'
                    AND COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) = 'L' THEN 'Platinum BT Long'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) = '33'
                    AND COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) = 'M' THEN 'Platinum BT Mid'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) = '33'
                    AND COALESCE(A.REQUESTED_PRODUCT_CLASS_CODE,B.REQUESTED_PRODUCT_CLASS_CODE) = 'T' THEN 'Platinum BT Short'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) = '91' THEN 'Avios'
                WHEN COALESCE(A.SOURCE_PRODUCT_CODE,B.SOURCE_PRODUCT_CODE) = '92' THEN 'Avios Plus'
                ELSE 'Unknown'
            END AS VARCHAR(20)) AS ACQ_SEGMENT2
            ,COALESCE(A.GEN_RULES, B.GEN_RULES) AS GEN_RULES
            ,COALESCE(A.PRODUCT_ACCEPTANCE_TYPE_CODE, B.PRODUCT_ACCEPTANCE_TYPE_CODE) AS PRODUCT_ACCEPTANCE_TYPE_CODE
            ,COALESCE(A.APR, B.APR) AS APR
            ,COALESCE(A.AVERAGE_RISK_SCORE, B.AVERAGE_RISK_SCORE) AS GEN_12_SCORE_NEW
            ,COALESCE(A.GEN16_OM_PRIME_SCORE, B.GEN16_OM_PRIME_SCORE) AS GEN16_OM_PRIME_SCORE
            ,COALESCE(A.AGGREGATOR_PARTNER_CODE,B.AGGREGATOR_PARTNER_CODE) AS AGGREGATOR_PARTNER_CODE
