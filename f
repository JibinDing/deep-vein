            MAX(CASE WHEN A.VOID_BALANCE_TRANSFER_AMOUNT IS NOT NULL THEN 1 ELSE 0 END) AS BT_VAL_CHANGE
        FROM IHQ_Q A
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY_ROLE B
            ON A.APPLICATION_IDENTIFIER=B.APPLICATION_IDENTIFIER
