        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_PARTY_ROLE E
            ON SUBSTR(TRIM(E.APPLICATION_IDENTIFIER),10)=A.LINKED_APPLICATION_NUMBER
