        SELECT
            A.APPLICATION_IDENTIFIER,
            A.LINKED_APPLICATION_NUMBER,
            B.APPLICATION_PARTY_INDENTIFIER AS LINKED_APPLICATION_PARTY_IDENTIFIER,
            CASE WHEN C.CURRENT_ADDRESS_INDICATOR = 'Y' THEN
                CONCAT(COALESCE(C.HOUSE_NUMBER, ''), COALESCE(C.FLAT_NUMBER, ''), COALESCE(C.HOUSE_NAME, ''), COALESCE(C.STREET_NAME, ''), COALESCE(C.TOWN_NAME, ''), COALESCE(C.DISTRICT_NAME, '')) END AS LINKED_ADDRESS,
            CASE WHEN C.CURRENT_ADDRESS_INDICATOR = 'N' THEN
                CONCAT(COALESCE(C.HOUSE_NUMBER, ''), COALESCE(C.FLAT_NUMBER, ''), COALESCE(C.HOUSE_NAME, ''), COALESCE(C.STREET_NAME, ''), COALESCE(C.TOWN_NAME, ''), COALESCE(C.DISTRICT_NAME, '')) END AS PRE_LINKED_ADDRESS,
