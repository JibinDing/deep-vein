    STG_2 AS (
        SELECT STAGE1.*,
            CSE.APPLICATION_IDENTIFIER,
            CSE.CASE_NUMBER,
            CSE.CASE_CREATION_DATE AS APPLICATION_RECEIVED_DATE
        FROM STG_1 AS STAGE1
        LEFT JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
            ON STAGE1.SDS_APP = CSE.APPLICATION_IDENTIFIER
