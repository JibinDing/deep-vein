            CASE WHEN C.CURRENT_ADDRESS_INDICATOR = 'N' THEN
                CONCAT(COALESCE(C.HOUSE_NUMBER, ''), COALESCE(C.FLAT_NUMBER, ''), COALESCE(C.HOUSE_NAME, ''), COALESCE(C.STREET_NAME, ''), COALESCE(C.TOWN_NAME, ''), COALESCE(C.DISTRICT_NAME, '')) END AS PRE_ADDRESS,
