                    AND SUBSTR(TRIM(A.REQUESTED_PRODUCT_DMI_CODE), 1, 2) = SUBSTR(TRIM(A.offered_product_15_code), 1, 2) THEN 'Y'
                ELSE 'N' END AS BT_GUARANTEE_FLAG
        FROM FQ_BASE A
